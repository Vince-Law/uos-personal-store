{
  "providers": {
    "openai": {
      "apiKey": "CHANGE_ME_OPENAI_API_KEY"
    }
  },
  "agents": {
    "defaults": {
      "model": "openai/gpt-4o-mini",
      "workspace": "~/.nanobot/workspace"
    }
  },
  "channels": {
    "telegram": {
      "enabled": false,
      "token": "CHANGE_ME_TELEGRAM_BOT_TOKEN",
      "allowFrom": [
        "123456789"
      ]
    }
  }
}
